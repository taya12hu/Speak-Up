# Copy to client/.env.local (gitignored). Vite exposes VITE_* variables to the browser bundle,
# so only public values belong here.

# Same project as server/.env (Dashboard → Project Settings → API).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (or the legacy "anon" key). NEVER put the service-role key in this file.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
