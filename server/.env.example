# Copy to server/.env and fill in. server/.env is gitignored — never commit real keys.

# Required for topic generation, vocab, sample answers and analysis.
# Free key (no billing): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Optional (defaults shown) ---

# Interface and port the API binds to. Keep 127.0.0.1 unless you understand that anyone
# who can reach the port can spend your Gemini quota and read your practice history.
# HOST=127.0.0.1
# PORT=4000

# Gemini model alias used for every call.
# GEMINI_MODEL=gemini-flash-lite-latest

# whisper.cpp CLI and model. Defaults resolve to <repo>/whisper/bin/whisper-cli(.exe)
# and <repo>/whisper/models/ggml-base.en.bin.
# WHISPER_BIN_PATH=
# WHISPER_MODEL_PATH=
# WHISPER_TIMEOUT_MS=300000

# Where sessions.json and temporary uploads live. Default: server/data
# DATA_DIR=
