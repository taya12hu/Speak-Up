# Copy to server/.env and fill in. server/.env is gitignored — never commit real keys.

# Required for topic generation, vocab, sample answers and analysis.
# Free key (no billing): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# --- Supabase (required: accounts and practice history) ---
# Dashboard → Project Settings → API. The publishable key (or the legacy "anon" key) is public;
# the server queries the database with each user's own token, so Row Level Security applies.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Only for projects still using the legacy shared JWT secret (HS256). Projects with asymmetric
# JWT signing keys (the default for new projects) are verified via their public JWKS instead.
# SUPABASE_JWT_SECRET=

# Server-side ONLY, and not used by the running API: needed solely by
# `npm run import:legacy` and the opt-in RUN_SUPABASE_TESTS=1 integration tests.
# It bypasses Row Level Security. Never give it a VITE_ prefix or put it in client/.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional (defaults shown) ---

# Interface and port the API binds to. Keep 127.0.0.1 unless the server sits behind a reverse
# proxy you control; every API route except /api/health requires a signed-in user.
# HOST=127.0.0.1
# PORT=4000

# Gemini model alias used for every call.
# GEMINI_MODEL=gemini-flash-lite-latest

# whisper.cpp CLI and model. Defaults resolve to <repo>/whisper/bin/whisper-cli(.exe)
# and <repo>/whisper/models/ggml-base.en.bin.
# WHISPER_BIN_PATH=
# WHISPER_MODEL_PATH=
# WHISPER_TIMEOUT_MS=300000
# Thread count for whisper.cpp. Default: derived from the container CPU quota (cgroup), else
# whisper's own default. Too many threads under a small CPU quota makes transcription much slower.
# WHISPER_THREADS=

# Where temporary audio uploads are staged during transcription (deleted after each request).
# Default: server/data
# DATA_DIR=
